{
  "expo": {
    "name": "Calculator",
    "slug": "deposito-seguro",
    "version": "1.0.0",
    "scheme": "depositoseguro",
    "orientation": "portrait",
    "icon": "./assets/icons/calculator-icons/calculator-icon-black-white.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "build": {
        "dist": "web-build"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.depositoseguro",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Calculator to import photos into your encrypted local partition.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/calculator-icons/calculator-icon-black-white.png",
        "backgroundColor": "#121212"
      },
      "package": "com.anonymous.depositoseguro",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-media-library",
      "expo-document-picker",
      "./plugins/withDisguiseIcon",
      "expo-status-bar"
    ],
    "updates": {
      "enabled": false
    },
    "extra": {
      "eas": {
        "projectId": "70c0d05e-eaac-4be3-8c76-b08ce480d6d2"
      }
    }
  }
}
