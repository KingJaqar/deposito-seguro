{
  "expo": {
    "name": "Deposito Seguro",
    "slug": "deposito-seguro",
    "version": "1.0.0",
    "scheme": "depositoseguro",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "web": {
      "build": {
        "dist": "web-build"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.depositoseguro",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Deposito Seguro to access the camera to capture secure photos directly into the isolated sandbox.",
        "NSPhotoLibraryUsageDescription": "Allow Deposito Seguro to import photos into your encrypted local partition.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleIcons": {
          "CFBundlePrimaryIcon": {
            "CFBundleIconFiles": [
              "icon"
            ]
          },
          "CFBundleAlternateIcons": {
            "default": {
              "CFBundleIconFiles": [
                "icon"
              ],
              "UIPrerenderedIcon": false
            },
            "calculator-icon-black-white": {
              "CFBundleIconFiles": [
                "calculator-icon-black-white"
              ],
              "UIPrerenderedIcon": false
            },
            "calculator-icon-black-orange": {
              "CFBundleIconFiles": [
                "calculator-icon-black-orange"
              ],
              "UIPrerenderedIcon": false
            },
            "calculator-icon-black-red": {
              "CFBundleIconFiles": [
                "calculator-icon-black-red"
              ],
              "UIPrerenderedIcon": false
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#121212"
      },
      "package": "com.anonymous.depositoseguro",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-video",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {
        "origin": "https://deposito-seguro.local,http://localhost:8081"
      },
      "eas": {
        "projectId": "70c0d05e-eaac-4be3-8c76-b08ce480d6d2"
      }
    }
  }
}
