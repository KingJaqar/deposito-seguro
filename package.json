{
  "name": "deposito-seguro",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "analyze": "echo '=== 1. Checking Expo Integrity ===' && cross-env EXPO_NO_TELEMETRY=1 npx expo-doctor && echo '=== 2. Running TypeScript Structural Check ===' && npx tsc --noEmit --ignoreDeprecations 6.0",
    "lint": "expo lint",
    "eas-build-pre-install": "npm config set legacy-peer-deps true"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.15",
    "expo-application": "^56.0.3",
    "expo-blur": "~56.0.0",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.20",
    "expo-linking": "~56.0.15",
    "expo-media-library": "~56.0.9",
    "expo-router": "~56.2.14",
    "expo-screen-orientation": "~56.0.0",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.21",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-video": "~56.1.4",
    "lucide-react-native": "^1.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-blob-util": "^0.24.9",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "^0.8.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "react-refresh": "^0.14.2",
    "typescript": "^6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo-blur",
        "expo-screen-orientation"
      ]
    }
  }
}
